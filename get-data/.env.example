# ============================================================================
# 取数服务配置。复制为 .env 后按需修改。.env 不会入库（见 .gitignore）。
# ============================================================================

# ---- HTTP 服务 ----
PORT=3000
HOST=127.0.0.1

# ---- 数据源 ----
# 主数据源（物品主数据：名称/官方ID/占格/品质/三级分类/出产地）。
# 官方接口无需任何凭据，仍是唯一主数据源。
ITEM_SOURCE=official

# 价格源：moligod | dergame | none
#   moligod —— v1 默认。1 次请求拿全量，5 分钟刷新，有现价+昨日均价+7日高低
#   dergame —— 应急备份。明文但需约 320 次请求，覆盖有价物品 91.3%
#   none    —— 不取价格（只显示物品主数据）
PRICE_SOURCE=moligod

# moligod 价格接口（换成不存在的域名可验证"价格源失效不影响主数据"）
MOLIGOD_BASE_URL=https://moligod.com

# dergame 价格接口（仅当 PRICE_SOURCE=dergame 时使用）
DERGAME_BASE_URL=https://dergame.cn

# ---- 刷新策略（按需触发，无定时器）----
# 快照年龄超过该值（分钟）→ 后台触发一次抓取，同时先把旧数据返回给页面
REFRESH_AFTER_MINUTES=15

# 快照年龄超过该值（分钟）→ 阻塞等待抓取完成再返回，而不是把很旧的价格摆出来
BLOCKING_REFRESH_AFTER_MINUTES=120

# 硬性最小抓取间隔（秒）—— 手动刷新也不能突破。防止狂点刷新或脚本刷接口
MIN_REFRESH_GAP_SECONDS=120

# 抓取失败后的冷却时间（秒）—— 冷却期内自动刷新跳过；手动刷新可绕过
FAILURE_COOLDOWN_SECONDS=300

# 连续失败该次数后，自动刷新完全停止（只保留手动刷新）
MAX_CONSECUTIVE_FAILURES=5

# ---- 礼貌策略 ----
# 请求头里的联系方式。请填你自己的邮箱 —— 万一站长看日志，得能找到人。
CONTACT_EMAIL=your-email@example.com
# 同域并发数（保持 1，串行）
CONCURRENCY=1
# 每次请求之间的随机延迟区间（毫秒）
REQUEST_DELAY_MIN_MS=1000
REQUEST_DELAY_MAX_MS=3000
# 单次请求超时（毫秒）
REQUEST_TIMEOUT_MS=20000
# 失败重试次数与退避基数（毫秒）：失败后等待 2s、4s、8s
RETRY_MAX=3
RETRY_BASE_DELAY_MS=2000

# ---- 存储 ----
# 快照目录（相对 get-data/）
DATA_DIR=data
# 历史快照保留天数（用于在未来计算涨跌幅）
HISTORY_KEEP_DAYS=8
# 保留多少轮原始响应（按源轮转删除最旧的）
RAW_KEEP_ROUNDS=48

# ---- 人工覆盖 ----
# 出产地人工覆盖（相对 get-data/），入库 git
PROVENANCE_OVERRIDES=overrides/provenance.json
# 可获得性 / 可上架 / 每组发数的人工标注（相对 get-data/），入库 git
ITEM_ATTRIBUTES_OVERRIDES=overrides/item-attributes.json

# ---- 日志 ----
LOG_LEVEL=info
